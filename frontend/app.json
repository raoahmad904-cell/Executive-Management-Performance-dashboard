    "web": {
      "output": "static"
    },
    "plugins": [],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "9c4375f6-14e8-485a-a8aa-f96f2bcc756f"
      }
    },
    "owner": "raoahmadrashid"
  }
}

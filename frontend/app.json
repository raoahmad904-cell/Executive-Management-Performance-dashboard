{
  "expo": {
    "name": "performanceDashboard",
    "slug": "performanceDashboard",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "performancedashboard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.performancedashboard",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d4c22d5a-0c5b-49d1-8fb1-9e68fedda5a4"
      }
    }
  }
}
